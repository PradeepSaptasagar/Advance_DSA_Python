from sortedcontainers import SortedList
import heapq

class Solution:
    def busiestServers(self, k: int, arrival: list[int], load: list[int]) -> list[int]:
        counts = [0] * k
        empty_servers = SortedList(range(k))
        in_use_servers = [] 
        
        for i in range(len(arrival)):
            current_time = arrival[i]
            
            # Step A: Free up servers whose tasks are completed
            while in_use_servers and in_use_servers[0][0] <= current_time:
                end_time, server_id = heapq.heappop(in_use_servers)
                empty_servers.add(server_id)
            
            # Step B: Drop request if all servers are busy
            if not empty_servers:
                continue
            
            # Step C: Find the next available server
            preferred_server = i % k
            index = empty_servers.bisect_left(preferred_server)
            
            # Wrap around if the preferred server is greater than all available servers
            if index == len(empty_servers):
                index = 0
                
            chosen_server = empty_servers[index]
            
            # Step D: Assign the task and update states
            empty_servers.pop(index)
            counts[chosen_server] += 1
            heapq.heappush(in_use_servers, (current_time + load[i], chosen_server))
            
        # Step E: Find all servers that handled the maximum number of requests
        max_requests = max(counts)
        return [i for i, count in enumerate(counts) if count == max_requests]
        
        
