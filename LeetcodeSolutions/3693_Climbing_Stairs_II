class Solution(object):
    def climbStairs(self, n, costs):
        """
        :type n: int
        :type costs: List[int]
        :rtype: int
        """
        n = len(costs)
        dp = [float('inf')] * (n + 1)
        dp[0] = 0

        for j in range(1, n + 1):
            # Limit the lookback to a maximum of 3 steps (i+1, i+2, i+3)
            for i in range(max(0, j - 3), j):
                # Pay the cost of the step you LAND on (costs[j-1])
                total_cost = dp[i] + costs[j - 1] + ((j - i) ** 2)
                
                if total_cost < dp[j]:
                    dp[j] = total_cost

        return dp[-1]
