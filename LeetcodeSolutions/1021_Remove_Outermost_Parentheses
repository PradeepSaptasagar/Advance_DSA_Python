# Approach 1: Two-Pointer Slicing (Your original logic)
def removeOuterParentheses_two_pointers(s: str) -> str:
    # TC: O(n), SC: O(n) for the result string
    depth, left, result = 0, 0, ""
    for right, char in enumerate(s):
        if char == "(": depth += 1
        else: depth -= 1
        if depth == 0:
            result += s[left+1:right]
            left = right + 1
    return result

# Approach 2: Character Filter (List Builder optimization)
def removeOuterParentheses_char_filter(s: str) -> str:
    # TC: O(n), SC: O(n) for the result list
    result, depth = [], 0
    for char in s:
        if char == "(":
            if depth > 0: result.append(char)
            depth += 1
        else:
            depth -= 1
            if depth > 0: result.append(char)
    return "".join(result)

# Approach 3: Stack Method (Classic interview pattern)
def removeOuterParentheses_stack(s: str) -> str:
    # TC: O(n), SC: O(n) for both stack and result list
    result, stack = [], []
    for char in s:
        if char == "(":
            if len(stack) > 0: result.append(char)
            stack.append(char)
        else:
            stack.pop()
            if len(stack) > 0: result.append(char)
    return "".join(result)
