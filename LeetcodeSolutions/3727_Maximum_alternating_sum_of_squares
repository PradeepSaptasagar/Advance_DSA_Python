class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        temp = []
        for i in nums:
            k = i ** 2
            temp.append(k)

        temp.sort()
        mid = len(temp) // 2
        
        return sum(temp[mid:]) - sum(temp[:mid])

