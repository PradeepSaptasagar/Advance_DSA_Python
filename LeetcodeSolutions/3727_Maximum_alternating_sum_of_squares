class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        n = len(nums)
        
        # Square directly into the original array
        for i in range(n):
            nums[i] = nums[i] ** 2
            
        # Sort the original array in-place
        nums.sort()
        
        mid = n // 2
        total = 0
        
        # Calculate the sum without using memory-heavy slices
        for i in range(n):
            if i < mid:
                total -= nums[i]
            else:
                total += nums[i]
                
        return total

